rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Cloud-Functions-only collection (QR share); clients never access it directly.
    match /shares/{shareId} {
      allow read, write: if false;
    }

    // Each user can read/write only their own subtree:
    // documents/*, profile/data, preferences/data, and keys/master.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Append-only public feedback. Clients may create with a valid email +
    // non-empty message; never read, update, or delete.
    match /feedback/{id} {
      allow create: if request.auth != null
                    && request.resource.data.email is string
                    && request.resource.data.message is string
                    && request.resource.data.message.size() > 0;
      allow read, update, delete: if false;
    }

  }
}
