rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // QR share uploads; reads go through Cloud Function signed URLs (rules bypassed).
    match /shared/{fileId}/{filename} {
      allow write: if request.resource.size < 10 * 1024 * 1024; // 10 MB max
      allow read: if false;
    }

    // Per-user encrypted document files — only the owning user can read/write/delete.
    match /users/{uid}/documents/{filename} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 50 * 1024 * 1024; // 50 MB max
    }

  }
}
