rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Allow the iOS app to upload files into the shared/ prefix.
    // Reads are blocked here — the doctor accesses files via Cloud Function
    // signed URLs, which bypass security rules entirely.
    match /shared/{fileId}/{filename} {
      allow write: if request.resource.size < 10 * 1024 * 1024; // 10 MB max
      allow read: if false;
    }

    // Per-user encrypted documents — only the owning user can read/write/delete
    match /users/{uid}/documents/{filename} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 50 * 1024 * 1024;
    }

  }
}
