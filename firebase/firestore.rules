rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // The shares collection is only written/read by Cloud Functions
    // (which use the Admin SDK and bypass these rules).
    // No client should access it directly.
    match /shares/{shareId} {
      allow read, write: if false;
    }

    // Each user can read/write only their own subtree:
    // documents/*, profile/data, preferences/data, and keys/master.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Append-only public feedback. Authenticated clients may create one doc with
    // a valid email + non-empty message and only the expected fields (size-capped
    // to limit abuse/cost); never read, update, or delete.
    match /feedback/{id} {
      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly(
                         ['email', 'message', 'createdAt', 'appVersion', 'platform', 'locale', 'uid'])
                    && request.resource.data.email is string
                    && request.resource.data.email.size() <= 254
                    && request.resource.data.message is string
                    && request.resource.data.message.size() > 0
                    && request.resource.data.message.size() <= 5000;
      allow read, update, delete: if false;
    }

  }
}
